---
import Brand from "../../layouts/Brand.astro";
import { services, EMAIL } from "../../data/services";
const jsiEmail = "justsystemsinitiatives@gmail.com";
---

<Brand
  title="Book a Clarity Call — JaiSellers Companies"
  description="Book a free 30-minute clarity call with Joshua Jai Sellers about 501(c)(3) formation, compliance recovery, grant readiness, or brand."
  current="/contact"
>
  <style>
    .contact { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(36px, 6vw, 96px); padding: clamp(56px, 8vw, 104px) 0; }
    .contact h1 { font-size: clamp(44px, 6vw, 76px); margin-top: 22px; }
    .contact .lede { margin-top: 22px; }
    .next { list-style: none; padding: 0; margin-top: 40px; counter-reset: s; }
    .next li { counter-increment: s; display: grid; grid-template-columns: 52px 1fr; gap: 6px 16px; padding: 18px 0; border-top: 1px solid var(--line-dark); }
    .next li::before { content: "0" counter(s); grid-row: span 2; font-family: var(--serif); font-size: 32px; color: var(--gold); line-height: 1; }
    .next b { font-weight: 500; }
    .next span { color: var(--muted-light); font-size: 15px; }
    .direct { margin-top: 36px; padding: 24px; border: 1px solid var(--line-dark); background: var(--ink-2); font-size: 15px; color: var(--muted-light); }
    .direct a { color: var(--gold-soft); }
    .direct p + p { margin-top: 10px; }

    form { background: var(--ivory); color: var(--text-dark); padding: clamp(28px, 4vw, 48px); align-self: start; }
    form h2 { font-size: 34px; color: var(--text-dark); }
    form .note { margin-top: 8px; font-size: 15px; color: var(--muted-dark); }
    .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 28px; }
    .full { grid-column: 1 / -1; }
    label { display: grid; gap: 7px; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted-dark); }
    input, select, textarea {
      width: 100%; font: 400 16px/1.4 var(--sans); color: var(--text-dark);
      padding: 13px 14px; border: 1px solid rgba(14,21,32,.2); background: #fffdf8; border-radius: 0;
    }
    input:focus, select:focus, textarea:focus { outline: 2px solid var(--gold); outline-offset: 1px; border-color: var(--gold-deep); }
    textarea { min-height: 130px; resize: vertical; }
    form .btn { margin-top: 26px; width: 100%; }
    .fine { margin-top: 14px; font-size: 13px; color: var(--muted-dark); text-align: center; }
    @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } }
    @media (max-width: 560px) { .fields { grid-template-columns: 1fr; } }
  </style>

  <section class="wrap contact">
    <div>
      <span class="eyebrow">Start here</span>
      <h1>Book a free <em>clarity call.</em></h1>
      <p class="lede">Thirty minutes by phone or video. We'll look at where your organization stands, what's urgent, and the fastest path to stable &mdash; whether or not we end up working together.</p>
      <ol class="next">
        <li><b>Send the short form</b><span>Two minutes. It tells me enough to make the call useful.</span></li>
        <li><b>I reply within one business day</b><span>With times that work, by email or phone.</span></li>
        <li><b>We talk, then you get a written scope</b><span>Fixed fee, plain language, no obligation.</span></li>
      </ol>
      <div class="direct">
        <p>Prefer to write directly? <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
        <p>For Justice Systems Initiative matters: <a href={`mailto:${jsiEmail}`}>{jsiEmail}</a></p>
      </div>
    </div>

    <form id="inquiry" novalidate>
      <h2>Tell me about your organization</h2>
      <p class="note">Submitting opens a pre-written email in your mail app. Just press send.</p>
      <div class="fields">
        <label>Your name<input name="name" autocomplete="name" required /></label>
        <label>Organization<input name="org" autocomplete="organization" /></label>
        <label>Email<input name="email" type="email" autocomplete="email" required /></label>
        <label>Phone (optional)<input name="phone" type="tel" autocomplete="tel" /></label>
        <label class="full">What do you need?
          <select name="service">
            {services.map((s) => <option>{s.name}</option>)}
            <option>Not sure yet — help me figure it out</option>
          </select>
        </label>
        <label>Organization status
          <select name="status">
            <option>Not yet incorporated</option>
            <option>Incorporated, no 501(c)(3) yet</option>
            <option>Active 501(c)(3)</option>
            <option>Exemption revoked / behind on filings</option>
            <option>Church or ministry</option>
            <option>Small business</option>
          </select>
        </label>
        <label>Timeline
          <select name="timeline">
            <option>Urgent — within 30 days</option>
            <option>Within the next 1–3 months</option>
            <option>Planning for next year</option>
          </select>
        </label>
        <label class="full">What's going on?<textarea name="message" placeholder="A few sentences on where things stand and what you'd like to be true in six months."></textarea></label>
      </div>
      <button class="btn btn-gold" type="submit">Request my clarity call <span class="arrow">&rarr;</span></button>
      <p class="fine">Your information goes only to Joshua Jai Sellers. Never shared, never sold.</p>
    </form>
  </section>

  <script is:inline define:vars={{ EMAIL }}>
    document.getElementById("inquiry").addEventListener("submit", function (e) {
      e.preventDefault();
      var f = e.target, d = new FormData(f);
      if (!d.get("name") || !d.get("email")) { f.reportValidity && f.reportValidity(); (f.name.value ? f.email : f.name).focus(); return; }
      var subject = "Clarity call request — " + (d.get("org") || d.get("name"));
      var body = [
        "Name: " + d.get("name"),
        "Organization: " + (d.get("org") || "—"),
        "Email: " + d.get("email"),
        "Phone: " + (d.get("phone") || "—"),
        "Need: " + d.get("service"),
        "Status: " + d.get("status"),
        "Timeline: " + d.get("timeline"),
        "",
        d.get("message") || ""
      ].join("\n");
      window.location.href = "mailto:" + EMAIL + "?subject=" + encodeURIComponent(subject) + "&body=" + encodeURIComponent(body);
    });
  </script>
</Brand>
