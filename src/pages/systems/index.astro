---
import Brand from "../../layouts/Brand.astro";
const brand = "JaiSellers Companies";
const title = "Systems Framework";
const description = "A simple framework for building governance, revenue, and narrative systems that last.";
const layers = [
  { n: "01", t: "Governance", d: "Roles, policies, decision-making, board ops, compliance rhythm.", items: ["Bylaws + policies", "Board cadence + packets", "Risk controls"] },
  { n: "02", t: "Revenue", d: "Budget architecture + grant readiness + pipeline + reporting.", items: ["Program budgets", "Grant calendar", "Reporting system"] },
  { n: "03", t: "Narrative", d: "Messaging and brand assets aligned to what you can truly deliver.", items: ["Case for support", "Homepage copy", "Campaign templates"] },
];
---

<Brand title={`${title} — ${brand}`} description={description} current="/consulting">
  <style>
    .intro { padding: clamp(64px, 9vw, 120px) 0 clamp(48px, 6vw, 80px); border-bottom: 1px solid var(--line-dark); background: radial-gradient(50% 80% at 90% 0%, rgba(201,168,76,.14), transparent 70%); }
    .intro h1 { margin-top: 22px; max-width: 16ch; }
    .intro .lede { margin-top: 24px; max-width: 64ch; }
    .layers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line-light); border: 1px solid var(--line-light); }
    .layer { background: var(--ivory); padding: clamp(28px, 4vw, 44px); }
    .layer .n { font-family: var(--serif); font-size: 18px; letter-spacing: .2em; color: var(--gold-deep); }
    .layer h3 { margin-top: 10px; font-size: 32px; }
    .layer > p { margin-top: 12px; }
    .layer ul { list-style: none; padding: 0; margin-top: 20px; display: grid; gap: 10px; }
    .layer li { position: relative; padding-left: 26px; color: var(--muted-dark); }
    .layer li::before { content: ""; position: absolute; left: 0; top: .78em; width: 14px; height: 1px; background: var(--gold-deep); }
    .get { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
    .get .lede { margin-top: 18px; }
    .get .panel { border: 1px solid var(--line-dark); background: var(--ink-3); padding: clamp(28px, 4vw, 44px); }
    .get .panel p { margin-top: 10px; color: var(--muted-light); }
    .get .panel .btn { margin-top: 24px; }
    @media (max-width: 860px) { .layers, .get { grid-template-columns: 1fr; } }
  </style>

  <section class="intro">
    <div class="wrap">
      <span class="eyebrow">Framework</span>
      <h1>Vision &rarr; Structure &rarr; <em>Sustain</em></h1>
      <p class="lede">We build in a predictable order so organizations don’t collapse under stress: clarity first, then governance, then funding systems, then narrative execution.</p>
    </div>
  </section>

  <section class="section section-ivory">
    <div class="wrap">
      <span class="eyebrow">The three layers</span>
      <h2 style="margin:18px 0 clamp(32px, 5vw, 56px)">Built in <em>order.</em></h2>
      <div class="layers">
        {layers.map((l) => (
          <article class="layer">
            <span class="n">{l.n}</span>
            <h3>{l.t}</h3>
            <p>{l.d}</p>
            <ul>{l.items.map((i) => <li>{i}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap get">
      <div>
        <span class="eyebrow">What you get</span>
        <h2 style="margin-top:18px">Not just <em>advice.</em></h2>
        <p class="lede">We deliver templates, checklists, trackers, and a maintenance rhythm your team can run.</p>
      </div>
      <div class="panel">
        <h3 class="gold-text">Start with structure</h3>
        <p>If you’re unsure what’s next, start with a consult.</p>
        <a class="btn btn-gold" href="/contact">Book a free clarity call <span class="arrow">&rarr;</span></a>
      </div>
    </div>
  </section>
</Brand>
