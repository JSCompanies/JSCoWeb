---
import Brand from "../../layouts/Brand.astro";
const title = "Services & Pricing";
const brand = "JaiSellers Companies";
const division = "JaiSellers Consulting";
const description = "Compliance, funding, and systems support for small and mid-sized nonprofits. Flat fees, plain language, no surprises.";

const compliance = [
  {
    name: "990-N (e-Postcard)",
    desc: "Annual filing for orgs with receipts of $50K or less.",
    price: "$100",
  },
  {
    name: "990 Review & Filing Assist",
    desc: "You supply clean numbers; I review, complete, and prep for filing.",
    price: "$350",
  },
  {
    name: "990-EZ Preparation",
    desc: "Full prep for receipts under $200K and assets under $500K.",
    price: "$650",
  },
  {
    name: "Full Form 990 Preparation",
    desc: "Complete return with schedules, prepared from your records.",
    price: "$1,200",
  },
  {
    name: "Records Cleanup",
    desc: "Organizing books before filing. Quoted up front.",
    price: "$60/hr",
  },
];

const giving = [
  {
    name: "Year-End Appeal Sprint",
    desc: "Campaign plan, 4 emails, 6 social graphics, appeal letter.",
    price: "$900",
  },
  {
    name: "Sprint Lite",
    desc: "Campaign plan plus a 3-email series.",
    price: "$500",
  },
];

const funding = [
  {
    name: "2027 Grant Calendar",
    desc: "20 vetted funders with deadlines, fit notes, and a tracker.",
    price: "$750",
  },
  {
    name: "Grant Calendar Lite",
    desc: "10 vetted funders plus a tracker.",
    price: "$400",
  },
  {
    name: "Grant Proposal Writing",
    desc: "One complete application, start to submission-ready.",
    price: "$750",
  },
];

const ai = [
  {
    name: "AI Readiness Package",
    desc: "90-minute workshop, AI use policy, and tool setup.",
    price: "$600",
  },
  {
    name: "AI Use Policy Only",
    desc: "A custom one-page policy your board can adopt.",
    price: "$250",
  },
];
---

<Brand title={`${title} — ${brand}`} description={description} current="/consulting">
  <style>
      :global(body) { --sh-dark: #111113; --sh-accent: #9c7c2c; --sh-gold: #c9a84c; --sh-ink: #2c2c2c; --sh-ink-strong: #1f1f1f; --sh-ink-muted: #4a4a4a; --sh-ink-light: #ede5d6; --sh-rule: #e4e1d8; --sheet-pad: 56px; }



      .sheets { color: var(--sh-ink); }
      .sheets a { color: var(--sh-accent); }
      .sheets a:hover { color: var(--sh-dark); }


      .sheets {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 32px;
        padding: clamp(32px, 5vw, 56px) 4px clamp(56px, 8vw, 96px);
      }

      /* One letter-size page of the one-sheet. */
      .sheet {
        width: 100%;
        max-width: 816px;
        background: #fff;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
        display: flex;
        flex-direction: column;
      }

      /* Navy masthead on the front page. */
      .masthead {
        background: var(--sh-dark);
        padding: 40px var(--sheet-pad) 32px;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .masthead .kicker {
        font-size: 16px;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--sh-gold);
        font-weight: 500;
      }
      .masthead h1 {
        margin: 0;
        font-family: "Cormorant Garamond", Georgia, serif;
        font-weight: 600;
        font-size: 50px;
        line-height: 1.05;
        color: #fff;
      }
      .masthead .rule {
        width: 72px;
        height: 3px;
        background: var(--sh-gold);
        margin-top: 8px;
      }
      .masthead p {
        margin: 8px 0 0;
        font-size: 21px;
        line-height: 1.4;
        color: var(--sh-ink-light);
      }

      .sheet-body {
        padding: 28px var(--sheet-pad) 0;
        display: flex;
        flex-direction: column;
        gap: 14px;
        flex-grow: 1;
      }
      .sheet-body.no-masthead {
        padding-top: 40px;
      }

      /* Section head: serif heading on the left, a note on the right. */
      .section-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 24px;
        border-bottom: 2px solid var(--sh-gold);
        padding-bottom: 6px;
        margin-bottom: 0;
      }
      .section-head + .section-head,
      .rows + .section-head {
        margin-top: 14px;
      }
      .section-head h2 {
        margin: 0;
        font-family: "Cormorant Garamond", Georgia, serif;
        font-weight: 700;
        font-size: 34px;
        line-height: 1.1;
        color: var(--sh-accent);
      }
      .section-head .meta {
        font-size: 17px;
        color: var(--sh-ink-muted);
      }

      /* Priced line items. */
      .rows {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .rows li {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 24px;
        padding: 4px 0 8px;
        border-bottom: 1px solid var(--sh-rule);
      }
      .rows .item {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .rows h3 {
        margin: 0;
        font-size: 22px;
        font-weight: 600;
        line-height: 1.2;
        color: var(--sh-ink-strong);
      }
      .rows p {
        margin: 0;
        font-size: 18px;
        line-height: 1.35;
        color: var(--sh-ink-muted);
      }
      .rows .price {
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: 30px;
        font-weight: 700;
        color: var(--sh-accent);
        white-space: nowrap;
      }

      /* Retainer band. */
      .retainer {
        margin-top: 14px;
        background: var(--sh-dark);
        padding: 22px 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
      }
      .retainer .retainer-copy {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      .retainer h2 {
        margin: 0;
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: 32px;
        font-weight: 700;
        line-height: 1.1;
        color: #fff;
      }
      .retainer p {
        margin: 0;
        font-size: 19px;
        line-height: 1.35;
        color: var(--sh-ink-light);
      }
      .retainer .price {
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: 34px;
        font-weight: 700;
        color: var(--sh-gold);
        white-space: nowrap;
      }

      /* Seasonal rate note. */
      .rate-note {
        border: 2px solid var(--sh-gold);
        padding: 14px 22px;
        font-size: 20px;
        line-height: 1.4;
        color: var(--sh-ink-strong);
      }
      .rate-note strong {
        color: var(--sh-accent);
      }

      /* Front page foot. */
      .sheet-foot {
        padding: 18px var(--sheet-pad) 26px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        font-size: 17px;
        color: var(--sh-ink-muted);
      }
      .sheet-foot .turn {
        color: var(--sh-accent);
        font-weight: 500;
      }

      /* Back page contact block. */
      .contact {
        padding: 20px var(--sheet-pad) 28px;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .contact h2 {
        margin: 0;
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: 28px;
        font-weight: 700;
        line-height: 1.15;
        color: var(--sh-accent);
      }
      .contact p {
        margin: 0;
        font-size: 20px;
        line-height: 1.4;
        color: var(--sh-ink);
      }


      @media (max-width: 760px) {
        :root {
          --sheet-pad: 24px;
        }
        .masthead h1 {
          font-size: 38px;
        }
        .masthead p {
          font-size: 18px;
        }
        .section-head {
          flex-direction: column;
          gap: 2px;
        }
        .section-head h2 {
          font-size: 28px;
        }
        .rows li,
        .retainer {
          flex-direction: column;
          align-items: flex-start;
          gap: 6px;
        }
        .rows h3 {
          font-size: 20px;
        }
        .rows p {
          font-size: 17px;
        }
        .sheet-foot {
          flex-direction: column;
          align-items: flex-start;
          gap: 6px;
        }
      }

      /* Prints as the two-page letter one-sheet it was designed as. */
      @media print {
        :global(body) {
          background: #fff;
        }
        :global(.site-header),
        :global(.site-footer),
        .sheet-intro {
          display: none;
        }
        .sheets {
          gap: 0;
          padding: 0;
        }
        .sheet {
          max-width: none;
          width: 8.5in;
          min-height: 11in;
          box-shadow: none;
          break-after: page;
        }
        .sheet:last-child {
          break-after: auto;
        }
      }
      .sheet-intro { padding: clamp(56px, 8vw, 104px) 0 clamp(24px, 4vw, 40px); border-bottom: 1px solid var(--line-dark); background: radial-gradient(50% 80% at 90% 0%, rgba(201,168,76,.14), transparent 70%); }
      .sheet-intro h1 { margin-top: 22px; }
      .sheet-intro .lede { margin-top: 20px; }
      .sheet-intro .ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  </style>

  <section class="sheet-intro">
    <div class="wrap">
      <span class="eyebrow">{division}</span>
      <h1>Services &amp; <em>Pricing</em></h1>
      <p class="lede">The printable fee sheet. Print or save as PDF for a two-page letter-size handout.</p>
      <div class="ctas">
        <a class="btn btn-gold" href="/contact">Book a free clarity call <span class="arrow">&rarr;</span></a>
        <a class="btn btn-line" href="/consulting">All services</a>
      </div>
    </div>
  </section>


    <main class="sheets">
      <!-- Front: Compliance & Year-End -->
      <article class="sheet" aria-label="Services and pricing, front">
        <div class="masthead">
          <p class="kicker">{division} · Services &amp; Pricing</p>
          <h1>Structure for work that has to hold.</h1>
          <div class="rule"></div>
          <p>
            Compliance, funding, and systems support for small and mid-sized
            nonprofits. Flat fees, plain language, no surprises.
          </p>
        </div>

        <div class="sheet-body">
          <div class="section-head">
            <h2>Form 990 Compliance</h2>
            <p class="meta">Extended deadline: Nov 16</p>
          </div>
          <ul class="rows">
            {
              compliance.map((item) => (
                <li>
                  <div class="item">
                    <h3>{item.name}</h3>
                    <p>{item.desc}</p>
                  </div>
                  <div class="price">{item.price}</div>
                </li>
              ))
            }
          </ul>

          <div class="section-head">
            <h2>Year-End Giving</h2>
            <p class="meta">Giving Tuesday: Dec 1</p>
          </div>
          <ul class="rows">
            {
              giving.map((item) => (
                <li>
                  <div class="item">
                    <h3>{item.name}</h3>
                    <p>{item.desc}</p>
                  </div>
                  <div class="price">{item.price}</div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="sheet-foot">
          <span>Kings Mountain, North Carolina</span>
          <span class="turn">More on the back →</span>
        </div>
      </article>

      <!-- Back: Funding, AI & Retainer -->
      <article class="sheet" aria-label="Services and pricing, back">
        <div class="sheet-body no-masthead">
          <div class="section-head">
            <h2>Funding &amp; Grants</h2>
            <p class="meta">Flat fees, never a percentage</p>
          </div>
          <ul class="rows">
            {
              funding.map((item) => (
                <li>
                  <div class="item">
                    <h3>{item.name}</h3>
                    <p>{item.desc}</p>
                  </div>
                  <div class="price">{item.price}</div>
                </li>
              ))
            }
          </ul>

          <div class="section-head">
            <h2>AI Readiness</h2>
            <p class="meta">Practical, not hype</p>
          </div>
          <ul class="rows">
            {
              ai.map((item) => (
                <li>
                  <div class="item">
                    <h3>{item.name}</h3>
                    <p>{item.desc}</p>
                  </div>
                  <div class="price">{item.price}</div>
                </li>
              ))
            }
          </ul>

          <div class="retainer">
            <div class="retainer-copy">
              <h2>Monthly Retainer</h2>
              <p>
                Grant tracking, light writing, and a monthly check-in. Cancel
                anytime.
              </p>
            </div>
            <div class="price">$300/mo</div>
          </div>

          <p class="rate-note">
            <strong>Fall rate:</strong> 10% off any package for returning and
            referred clients through December 31, 2026.
          </p>
        </div>

        <div class="contact">
          <h2>Start with a free 20-minute call.</h2>
          <p>
            Josh Sellers · <a href="mailto:joshuajaisellers@gmail.com"
              >joshuajaisellers@gmail.com</a
            > · <a href="tel:+17047184209">704-718-4209</a>
          </p>
          <p>jaisellers.com · Kings Mountain, NC</p>
        </div>
      </article>
    </main>
</Brand>
