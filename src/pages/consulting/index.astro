---
import Brand from "../../layouts/Brand.astro";
import { services } from "../../data/services";
---

<Brand
  title="Services — JaiSellers Consulting"
  description="Fixed-fee nonprofit formation, 501(c)(3) reinstatement, 990 compliance, grant readiness, grant writing, and brand engagements."
  current="/consulting"
>
  <style>
    .intro { padding: clamp(64px, 9vw, 120px) 0 clamp(48px, 6vw, 80px); border-bottom: 1px solid var(--line-dark); background: radial-gradient(50% 80% at 90% 0%, rgba(201,168,76,.14), transparent 70%); }
    .intro h1 { margin-top: 22px; max-width: 14ch; }
    .intro .lede { margin-top: 24px; }
    .intro .ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
    .svc-card { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 72px); padding: clamp(40px, 6vw, 72px) 0; border-bottom: 1px solid var(--line-light); scroll-margin-top: 90px; }
    .svc-card .num { font-family: var(--serif); font-size: 18px; letter-spacing: .2em; color: var(--gold-deep); }
    .svc-card h2 { font-size: clamp(32px, 3.6vw, 46px); margin-top: 10px; }
    .svc-card .hook { margin-top: 16px; font-size: 19px; color: var(--text-dark) !important; }
    .svc-card .best { margin-top: 16px; }
    .svc-card .best b { font-weight: 500; color: var(--text-dark); }
    .svc-card h4 { font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--gold-deep); font-weight: 500; margin-bottom: 16px; }
    .svc-card ul { list-style: none; padding: 0; display: grid; gap: 12px; }
    .svc-card li { position: relative; padding-left: 26px; color: var(--muted-dark); }
    .svc-card li::before { content: ""; position: absolute; left: 0; top: .78em; width: 14px; height: 1px; background: var(--gold-deep); }
    .svc-card .btn { margin-top: 28px; }
    .fit { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line-dark); border: 1px solid var(--line-dark); margin-top: 40px; }
    .fit div { background: var(--ink); padding: clamp(28px, 4vw, 44px); }
    .fit h3 { font-size: 30px; }
    .fit ul { margin-top: 18px; padding-left: 18px; color: var(--muted-light); display: grid; gap: 10px; }
    .closing { text-align: center; }
    .closing h2 { max-width: 18ch; margin: 18px auto 0; }
    .closing .btn { margin-top: 34px; }
    @media (max-width: 860px) { .svc-card, .fit { grid-template-columns: 1fr; } }
  </style>

  <section class="intro">
    <div class="wrap">
      <span class="eyebrow">JaiSellers Consulting</span>
      <h1>Structure that makes you <em>fundable.</em></h1>
      <p class="lede">Fixed-fee engagements for nonprofits, churches, and mission-driven organizations. Each one is scoped in writing and ends with documents you own and understand.</p>
      <div class="ctas">
        <a class="btn btn-gold" href="/contact">Book a free clarity call <span class="arrow">&rarr;</span></a>
        <a class="btn btn-line" href="/#approach">About Joshua</a>
      </div>
    </div>
  </section>

  <section class="section-ivory">
    <div class="wrap">
      {services.map((s) => (
        <article class="svc-card" id={s.id}>
          <div>
            <div class="num">{s.num}</div>
            <h2>{s.name}</h2>
            <p class="hook">{s.hook}</p>
            <p class="best"><b>Best for:</b> {s.bestFor}</p>
            <a class="btn btn-ink" href="/contact">Ask about this <span class="arrow">&rarr;</span></a>
          </div>
          <div>
            <h4>What you receive</h4>
            <ul>{s.deliverables.map((d) => <li>{d}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Fit check</span>
      <h2 style="margin-top:18px">Structure, <em>not vibes.</em></h2>
      <div class="fit">
        <div>
          <h3 class="gold-text">A strong fit</h3>
          <ul>
            <li>You're serious about compliance and clarity</li>
            <li>You want systems your team can maintain</li>
            <li>Decision-makers will be at the table</li>
            <li>You need funding to stop being random</li>
          </ul>
        </div>
        <div>
          <h3>Not a fit</h3>
          <ul>
            <li>You want shortcuts or &ldquo;guaranteed grants&rdquo;</li>
            <li>You need a nonprofit built overnight for a deadline</li>
            <li>Leadership won't engage with the documents</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-ink2 closing">
    <div class="wrap">
      <span class="eyebrow">Next step</span>
      <h2>Thirty minutes to a <em>clear plan.</em></h2>
      <a class="btn btn-gold" href="/contact">Book a free clarity call <span class="arrow">&rarr;</span></a>
    </div>
  </section>
</Brand>
