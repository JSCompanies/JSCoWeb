---
import Brand from "../../layouts/Brand.astro";
const brand = "JaiSellers Companies";
const title = "Justice Systems Initiative";
const description = "Justice Systems Initiative is a nonprofit organization in formation building pathways from incarceration to opportunity.";
const email = "jsi.cleveland@gmail.com";
const workAreas = [
  ["Education & Information", "Plain-language educational materials that help incarcerated people better understand systems, opportunities, and resources available to them."],
  ["Reentry Preparation", "Information related to employment, identification, housing, benefits, education, transportation, and rebuilding life after incarceration."],
  ["Family Connection", "Resources that help families understand incarceration, communicate effectively, prepare for release, and navigate community services."],
  ["Justice & Civic Literacy", "Educational content that explains courts, local government, public systems, rights, responsibilities, and civic participation in accessible language."],
  ["Faith & Encouragement", "Optional inspirational and faith-based materials designed to support reflection, resilience, hope, and personal growth."],
];
const materials = [
  "Reentry planning guides",
  "Employment and workforce information",
  "Housing and identification resources",
  "Educational opportunities",
  "Family-support information",
  "Civic and justice-system literacy",
  "Life-skills materials",
  "Faith and inspirational reflections",
  "Community-resource directories",
];
const commitments = ["Educational", "Accurate", "Respectful", "Accessible", "Constructive"];
const connect = [
  ["Partnerships", "Educational, nonprofit, faith, civic, and reentry partners."],
  ["Educational materials", "Program inquiries for JSI Inside/Out and resource mailing."],
  ["Volunteer opportunities", "Board development, community support, and future launch needs."],
];
---

<Brand title={`${title} | ${brand}`} description={description} current="/jsi">
  <style>
    .hero { padding: clamp(64px, 9vw, 120px) 0; border-bottom: 1px solid var(--line-dark); background: radial-gradient(50% 80% at 90% 0%, rgba(201,168,76,.14), transparent 70%); }
    .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
    .hero h1 { margin-top: 22px; max-width: 13ch; }
    .hero .lede { margin-top: 22px; }
    .hero .ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
    .logo-panel { background: var(--ivory); padding: clamp(24px, 4vw, 44px); }
    .logo-panel img { margin: 0 auto; max-height: 270px; width: auto; object-fit: contain; }
    .signature { border-left: 3px solid var(--gold); background: var(--ink-3); padding: 22px 24px; font-family: var(--serif); font-size: clamp(24px, 3vw, 32px); line-height: 1.1; color: var(--text-light); }
    .head h2 { margin-top: 18px; }
    .head p + p { margin-top: 14px; }
    .grid5 { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--line-light); border: 1px solid var(--line-light); }
    .card { background: var(--ivory); padding: 26px 22px; }
    .card .n { display: block; font-family: var(--serif); font-size: 18px; letter-spacing: .2em; color: var(--gold-deep); margin-bottom: 14px; }
    .card h3 { font-size: 24px; }
    .card p { margin-top: 10px; font-size: 16px; }
    .inside { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
    .inside h2 { margin-top: 18px; }
    .inside .lede { margin-top: 20px; }
    .quote { margin-top: 26px; border-left: 3px solid var(--gold); padding: 6px 0 6px 22px; font-family: var(--serif); font-size: 24px; line-height: 1.3; color: var(--text-light); }
    .materials { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line-dark); border: 1px solid var(--line-dark); }
    .materials div { background: var(--ink); padding: 18px 20px; display: flex; align-items: center; gap: 14px; color: var(--text-light); }
    .materials div::before { content: ""; width: 8px; height: 8px; flex: 0 0 auto; background: var(--gold); }
    .why { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(28px, 5vw, 72px); }
    .commit { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--line-light); border: 1px solid var(--line-light); margin: 34px 0; }
    .commit span { background: var(--ivory); min-height: 82px; display: grid; place-items: center; font-size: 13px; letter-spacing: .18em; text-transform: uppercase; color: var(--text-dark); font-weight: 500; }
    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line-light); border: 1px solid var(--line-light); }
    .status { max-width: 820px; }
    .status h2 { margin-top: 18px; }
    .status .lede { margin-top: 20px; }
    .status .note { margin-top: 22px; font-size: 14px; letter-spacing: .08em; color: var(--gold-soft); }
    .grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line-light); border: 1px solid var(--line-light); }
    .grid4 a { color: var(--gold-deep); word-break: break-word; }
    @media (max-width: 980px) {
      .hero-grid, .inside, .why, .grid5, .grid2, .grid4 { grid-template-columns: 1fr; }
      .commit, .materials { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 560px) { .commit, .materials { grid-template-columns: 1fr; } }
  </style>

  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Nonprofit organization in formation</span>
        <h1>Building pathways from incarceration to <em>opportunity.</em></h1>
        <p class="lede">Justice Systems Initiative is a developing nonprofit organization working to improve access to information, support, advocacy, and reentry resources for people impacted by the criminal justice system and their families.</p>
        <p class="lede">Our work is grounded in a simple belief: people should not lose access to knowledge, dignity, connection, or opportunity simply because they are incarcerated.</p>
        <div class="ctas">
          <a class="btn btn-gold" href="#inside-out">View JSI Inside/Out <span class="arrow">&rarr;</span></a>
          <a class="btn btn-line" href={"mailto:" + email + "?subject=Justice%20Systems%20Initiative%20Inquiry"}>Connect with JSI</a>
        </div>
      </div>
      <div>
        <div class="logo-panel">
          <img src="/images/jsi-logo-stacked.png" alt="Justice Systems Initiative. Justice. Stewardship. Integrity." />
        </div>
        <div class="signature">Preparation should begin before the gate opens.</div>
      </div>
    </div>
  </section>

  <section class="section section-ivory">
    <div class="wrap">
      <div class="section-head head">
        <div>
          <span class="eyebrow">What we do</span>
          <h2>Information, preparation, and <em>connection.</em></h2>
        </div>
        <p class="lede">JSI develops practical resources that help people and families navigate incarceration, release, and the public systems surrounding both.</p>
      </div>
      <div class="grid5">
        {workAreas.map(([heading, text], index) => (
          <article class="card">
            <span class="n">{String(index + 1).padStart(2, "0")}</span>
            <h3>{heading}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="inside-out" class="section" style="scroll-margin-top: 90px">
    <div class="wrap inside">
      <div>
        <span class="eyebrow">JSI Inside/Out</span>
        <h2>Education. Connection. <em>Reentry.</em></h2>
        <p class="lede">JSI Inside/Out is our correctional education and resource-mailing initiative. Through partnerships with correctional communication providers and participating institutions, JSI plans to distribute educational and inspirational materials directly to incarcerated individuals.</p>
        <p class="quote">Our goal is not simply to send mail. Our goal is to make each mailing a bridge between where someone is and what may be possible next.</p>
      </div>
      <div class="materials">
        {materials.map((item) => <div>{item}</div>)}
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="section section-ink2">
    <div class="wrap why head">
      <div>
        <span class="eyebrow">Why this matters</span>
        <h2>The road home starts before the gate <em>opens.</em></h2>
      </div>
      <div>
        <p class="lede">Release from incarceration often comes with immediate practical barriers: identification, transportation, housing, employment, health care, technology access, family reunification, and understanding complex public systems.</p>
        <p class="lede">By getting useful information into people’s hands while they are incarcerated, JSI seeks to strengthen reentry preparation, family stability, personal agency, and access to community resources.</p>
      </div>
    </div>
  </section>

  <section class="section section-ivory">
    <div class="wrap">
      <div class="section-head head">
        <div>
          <span class="eyebrow">Our commitment</span>
          <h2>Dignity with <em>discipline.</em></h2>
        </div>
        <p class="lede">JSI materials are designed to be educational, accurate, respectful, accessible, and constructive.</p>
      </div>
      <div class="commit">
        {commitments.map((c) => <span>{c}</span>)}
      </div>
      <div class="grid2">
        <article class="card">
          <h3>Facility-aware communication</h3>
          <p>All correctional mailings are designed to comply with applicable facility rules and communication-provider requirements.</p>
        </article>
        <article class="card">
          <h3>Educational, not legal representation</h3>
          <p>JSI does not provide individualized legal representation through its educational mailing program.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap status">
      <span class="eyebrow">Organization status</span>
      <h2>In development for long-term <em>public benefit.</em></h2>
      <p class="lede">Justice Systems Initiative is currently in organizational development as a nonprofit initiative pursuing formal charitable nonprofit status. Its developing governance, programs, partnerships, and community work are being structured around long-term public benefit and measurable impact.</p>
      <p class="note">Nonprofit organization in formation. Formal charitable status is not yet approved.</p>
    </div>
  </section>

  <section class="section section-ivory">
    <div class="wrap">
      <span class="eyebrow">Connect with JSI</span>
      <h2 style="margin:18px 0 clamp(32px, 5vw, 56px); max-width: 22ch">Honoring dignity. Building pathways. <em>Strengthening communities.</em></h2>
      <div class="grid4">
        {connect.map(([h, p]) => (
          <article class="card"><h3>{h}</h3><p>{p}</p></article>
        ))}
        <article class="card"><h3>Email</h3><p><a href={"mailto:" + email}>{email}</a></p></article>
      </div>
    </div>
  </section>
</Brand>
