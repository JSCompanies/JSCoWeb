---
import Brand from "../../layouts/Brand.astro";
const brand = "JaiSellers Companies";
const title = "Client Gallery Access";
const galleryLink = "https://drive.google.com/drive/folders/1BdfZ60kcpVZXyesnULvF3cIn4Ss6JFHo?usp=sharing";
---

<Brand title={`${title} — ${brand}`} description="Client gallery access page for event photo delivery." current="/design" noindex>
  <style>
    .gallery { min-height: 60vh; display: grid; place-items: center; text-align: center; background: radial-gradient(50% 70% at 50% 0%, rgba(201,168,76,.12), transparent 70%); }
    .gallery h1 { margin-top: 22px; }
    .gallery .lede { margin: 22px auto 0; }
    .gallery .btn { margin-top: 34px; }
  </style>

  <section class="section gallery">
    <div class="wrap">
      <span class="eyebrow">Jai Galleries</span>
      <h1>Client Event <em>Gallery</em></h1>
      <p class="lede">There are no photos posted yet. Images will be uploaded after the event.</p>
      <p class="lede">You can still open the gallery folder now and refresh later for new uploads.</p>
      <a class="btn btn-gold" href={galleryLink} target="_blank" rel="noopener noreferrer">Open Client Gallery Folder <span class="arrow">&rarr;</span></a>
    </div>
  </section>
</Brand>
