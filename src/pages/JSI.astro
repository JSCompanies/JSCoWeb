---
const brand = "JaiSellers Companies";
const title = "Just Systems Initiative";
const email = "justsystemsinitiatives@gmail.com";
const inquiry = `mailto:${email}?subject=Just%20Systems%20Initiative%20Inquiry`;

const workAreas = [
  [
    "Education & Information",
    "Plain-language educational materials that help incarcerated people better understand systems, opportunities, and resources available to them.",
  ],
  [
    "Reentry Preparation",
    "Information related to employment, identification, housing, benefits, education, transportation, and rebuilding life after incarceration.",
  ],
  [
    "Family Connection",
    "Resources that help families understand incarceration, communicate effectively, prepare for release, and navigate community services.",
  ],
  [
    "Justice & Civic Literacy",
    "Educational content that explains courts, local government, public systems, rights, responsibilities, and civic participation in accessible language.",
  ],
  [
    "Faith & Encouragement",
    "Optional inspirational and faith-based materials designed to support reflection, resilience, hope, and personal growth.",
  ],
];

const materials = [
  "Reentry planning guides",
  "Employment and workforce information",
  "Housing and identification resources",
  "Educational opportunities",
  "Family-support information",
  "Civic and justice-system literacy",
  "Life-skills materials",
  "Faith and inspirational reflections",
  "Community-resource directories",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {brand}</title>
    <meta
      name="description"
      content="Just Systems Initiative is a nonprofit organization in formation building pathways from incarceration to opportunity."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Jost:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="topbar">
      <a class="home-link" href="/" aria-label="JaiSellers Companies home">
        <span class="home-mark">JSCo</span>
        <span>{brand}</span>
      </a>
      <nav class="nav" aria-label="Primary navigation">
        <a href="/">Home</a>
        <a href="#work">What We Do</a>
        <a href="#inside-out">Inside/Out</a>
        <a href="#status">Status</a>
        <a class="nav-cta" href={inquiry}>Connect</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-inner">
          <div class="hero-copy">
            <p class="kicker">Nonprofit organization in formation</p>
            <h1>Building pathways from incarceration to opportunity.</h1>
            <p class="lead">
              Just Systems Initiative is a developing nonprofit organization working to improve access to information, support, advocacy, and reentry resources for people impacted by the criminal justice system and their families.
            </p>
            <p class="lead">
              Our work is grounded in a simple belief: people should not lose access to knowledge, dignity, connection, or opportunity simply because they are incarcerated.
            </p>
            <div class="cta-row">
              <a class="button primary" href="#inside-out">View JSI Inside/Out</a>
              <a class="button secondary" href={inquiry}>Connect with JSI</a>
            </div>
          </div>

          <div class="hero-identity" aria-label="Justice Systems Initiative brand mark">
            <img
              src="/images/jsi-logo-stacked.png"
              alt="Justice Systems Initiative. Justice. Stewardship. Integrity."
            />
            <p>Preparation should begin before the gate opens.</p>
          </div>
        </div>
      </section>

      <section class="section" id="work">
        <div class="wrap">
          <div class="section-head">
            <p class="kicker">What We Do</p>
            <div>
              <h2>Information, preparation, and connection.</h2>
              <p>
                JSI develops practical resources that help people and families navigate incarceration, release, and the public systems surrounding both.
              </p>
            </div>
          </div>

          <div class="work-grid">
            {
              workAreas.map(([heading, text], index) => (
                <article class="work-card">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <h3>{heading}</h3>
                  <p>{text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section alt" id="inside-out">
        <div class="wrap inside-grid">
          <div>
            <p class="kicker">JSI Inside/Out</p>
            <h2>Education. Connection. Reentry.</h2>
            <p>
              JSI Inside/Out is our correctional education and resource-mailing initiative. Through partnerships with correctional communication providers and participating institutions, JSI plans to distribute educational and inspirational materials directly to incarcerated individuals.
            </p>
            <p class="callout">
              Our goal is not simply to send mail. Our goal is to make each mailing a bridge between where someone is and what may be possible next.
            </p>
          </div>

          <div class="materials">
            {materials.map((item) => <div class="material-card">{item}</div>)}
          </div>
        </div>
      </section>

      <section class="section dark">
        <div class="wrap section-head">
          <p class="kicker">Why This Matters</p>
          <div>
            <h2>The road home starts before the gate opens.</h2>
            <p>
              Release from incarceration often comes with immediate practical barriers: identification, transportation, housing, employment, health care, technology access, family reunification, and understanding complex public systems.
            </p>
            <p>
              By getting useful information into people&apos;s hands while they are incarcerated, JSI seeks to strengthen reentry preparation, family stability, personal agency, and access to community resources.
            </p>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <p class="kicker">Our Commitment</p>
            <div>
              <h2>Dignity with discipline.</h2>
              <p>
                JSI materials are designed to be educational, accurate, respectful, accessible, and constructive.
              </p>
            </div>
          </div>
          <div class="commitment-row" aria-label="JSI commitments">
            <span>Educational</span>
            <span>Accurate</span>
            <span>Respectful</span>
            <span>Accessible</span>
            <span>Constructive</span>
          </div>
          <div class="two-grid">
            <article class="plain-card">
              <h3>Facility-aware communication</h3>
              <p>
                All correctional mailings are designed to comply with applicable facility rules and communication-provider requirements.
              </p>
            </article>
            <article class="plain-card">
              <h3>Educational, not legal representation</h3>
              <p>
                JSI does not provide individualized legal representation through its educational mailing program.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="section alt" id="status">
        <div class="wrap section-head">
          <p class="kicker">Organization Status</p>
          <div>
            <h2>In development for long-term public benefit.</h2>
            <p>
              Just Systems Initiative is currently in organizational development as a nonprofit initiative pursuing formal charitable nonprofit status. Its developing governance, programs, partnerships, and community work are being structured around long-term public benefit and measurable impact.
            </p>
            <p class="status-note">
              JSI is a nonprofit organization in formation, not yet an approved 501(c)(3).
            </p>
          </div>
        </div>
      </section>

      <section class="section connect">
        <div class="wrap">
          <div class="section-head">
            <p class="kicker">Connect With JSI</p>
            <div>
              <h2>Honoring dignity. Building pathways. Strengthening communities.</h2>
            </div>
          </div>
          <div class="connect-grid">
            <article class="plain-card">
              <h3>Partnerships</h3>
              <p>Educational, nonprofit, faith, civic, and reentry partners.</p>
            </article>
            <article class="plain-card">
              <h3>Educational materials</h3>
              <p>Program inquiries for JSI Inside/Out and resource mailing.</p>
            </article>
            <article class="plain-card">
              <h3>Volunteer opportunities</h3>
              <p>Board development, community support, and future launch needs.</p>
            </article>
            <article class="plain-card">
              <h3>Email</h3>
              <p><a href={"mailto:" + email}>{email}</a></p>
            </article>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <span>Just Systems Initiative</span>
        <span>Justice. Stewardship. Integrity.</span>
        <span>Nonprofit organization in formation. Formal charitable status is not yet approved.</span>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --paper: #f7f3eb;
    --paper-deep: #ebe4d7;
    --white: #fffdf8;
    --ink: #101823;
    --ink-soft: #354250;
    --gold: #c9a84c;
    --gold-deep: #9b7521;
    --green: #2f5148;
    --line: rgba(16, 24, 35, 0.14);
    --shadow: 0 26px 70px rgba(16, 24, 35, 0.12);
    --serif: "Cormorant Garamond", Georgia, "Times New Roman", serif;
    --sans: "Jost", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  p,
  h1,
  h2,
  h3 {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    font-family: var(--serif);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 0.98;
  }

  h1 {
    max-width: 13.5ch;
    margin-bottom: 24px;
    font-size: clamp(48px, 7vw, 88px);
  }

  h2 {
    margin-bottom: 16px;
    font-size: clamp(36px, 5vw, 68px);
  }

  h3 {
    margin-bottom: 10px;
    font-size: clamp(24px, 2.5vw, 32px);
  }

  :focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 4px;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 74px;
    padding: 14px clamp(20px, 4vw, 56px);
    background: rgba(247, 243, 235, 0.93);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(10px);
  }

  .home-link {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-right: auto;
    color: var(--ink);
    font-weight: 700;
  }

  .home-mark {
    display: inline-grid;
    min-width: 48px;
    min-height: 36px;
    place-items: center;
    border: 1px solid rgba(16, 24, 35, 0.2);
    color: var(--gold-deep);
    font-family: var(--serif);
    font-size: 18px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 28px);
    font-size: 14px;
    font-weight: 600;
  }

  .nav a {
    color: rgba(16, 24, 35, 0.76);
  }

  .nav a:hover {
    color: var(--ink);
  }

  .nav-cta {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 14px;
    border: 1px solid rgba(155, 117, 33, 0.38);
    background: rgba(255, 255, 255, 0.6);
    color: var(--ink);
  }

  .hero {
    position: relative;
    display: grid;
    align-items: center;
    overflow: hidden;
    background:
      linear-gradient(110deg, rgba(247, 243, 235, 0.98), rgba(255, 253, 248, 0.86) 52%, rgba(47, 81, 72, 0.16)),
      var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      90deg,
      rgba(16, 24, 35, 0.05) 0 1px,
      transparent 1px 124px
    );
  }

  .hero-inner,
  .wrap {
    width: min(1160px, calc(100% - 40px));
    margin: 0 auto;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
    gap: clamp(28px, 5vw, 70px);
    align-items: center;
    padding: clamp(48px, 7vw, 86px) 0;
  }

  .kicker {
    margin-bottom: 16px;
    color: var(--gold-deep);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .lead {
    max-width: 63ch;
    color: var(--ink-soft);
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.58;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border: 1px solid var(--line);
    border-radius: 2px;
    font-weight: 700;
  }

  .button.primary {
    background: var(--ink);
    color: #fffaf0;
    border-color: var(--ink);
  }

  .button.secondary {
    background: rgba(255, 255, 255, 0.7);
    color: var(--ink);
  }

  .hero-identity {
    padding: clamp(22px, 4vw, 42px);
    background: rgba(255, 255, 255, 0.84);
    border: 1px solid rgba(16, 24, 35, 0.12);
    box-shadow: var(--shadow);
  }

  .hero-identity img {
    width: min(100%, 520px);
    max-height: 290px;
    object-fit: contain;
    margin: 0 auto;
  }

  .hero-identity p {
    margin: 22px 0 0;
    padding: 20px;
    background: var(--ink);
    border-left: 4px solid var(--gold);
    color: #fffaf0;
    font-family: var(--serif);
    font-size: clamp(25px, 3vw, 36px);
    line-height: 1.05;
  }

  .section {
    padding: clamp(60px, 7vw, 98px) 0;
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }

  .section.alt {
    background: var(--paper-deep);
  }

  .section.dark {
    background: var(--ink);
    color: #fffaf0;
  }

  .section.dark h2,
  .section.dark p {
    color: #fffaf0;
  }

  .section.dark p {
    color: rgba(255, 250, 240, 0.78);
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(160px, 0.72fr) minmax(0, 1.28fr);
    gap: 28px;
    align-items: end;
    margin-bottom: 34px;
  }

  .section-head p,
  .inside-grid p,
  .plain-card p,
  .work-card p {
    color: var(--ink-soft);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
  }

  .work-card,
  .material-card,
  .plain-card,
  .callout {
    background: rgba(255, 255, 255, 0.68);
    border: 1px solid var(--line);
    box-shadow: 0 18px 50px rgba(16, 24, 35, 0.06);
  }

  .work-card,
  .plain-card {
    padding: 20px;
  }

  .work-card span {
    display: inline-block;
    margin-bottom: 18px;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--gold);
    color: var(--gold-deep);
    font-family: var(--serif);
    font-size: 25px;
    font-weight: 700;
    line-height: 1;
  }

  .inside-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 34px;
    align-items: start;
  }

  .materials {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .material-card {
    min-height: 68px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px;
    color: var(--ink);
    font-weight: 650;
  }

  .material-card::before {
    content: "";
    width: 9px;
    height: 9px;
    flex: 0 0 auto;
    background: var(--gold);
  }

  .callout {
    margin-top: 24px;
    padding: 24px;
    border-left: 4px solid var(--gold);
    font-family: var(--serif);
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 700;
    line-height: 1.12;
  }

  .commitment-row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    margin: 28px 0;
  }

  .commitment-row span {
    display: grid;
    min-height: 86px;
    place-items: center;
    padding: 12px;
    border: 1px solid var(--line);
    color: var(--ink);
    font-weight: 800;
    text-align: center;
  }

  .two-grid,
  .connect-grid {
    display: grid;
    gap: 12px;
  }

  .two-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .connect-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .status-note {
    margin-top: 22px;
    padding: 20px;
    background: rgba(255, 255, 255, 0.7);
    border-left: 4px solid var(--gold);
    font-weight: 700;
  }

  .connect a {
    color: var(--gold-deep);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer {
    padding: 28px 0;
    background: var(--ink);
    color: rgba(255, 250, 240, 0.72);
  }

  .footer-inner {
    width: min(1160px, calc(100% - 40px));
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 14px;
  }

  @media (max-width: 980px) {
    .hero-inner,
    .section-head,
    .inside-grid,
    .work-grid,
    .connect-grid {
      grid-template-columns: 1fr;
    }

    .commitment-row,
    .materials,
    .two-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 660px) {
    .topbar {
      align-items: flex-start;
      flex-direction: column;
    }

    .home-link {
      margin-right: 0;
    }

    .nav {
      width: 100%;
      flex-wrap: wrap;
      overflow: visible;
      padding-bottom: 4px;
    }

    .nav a {
      white-space: nowrap;
    }

    h1 {
      max-width: 100%;
      font-size: clamp(42px, 13vw, 62px);
    }

    .cta-row,
    .button,
    .commitment-row,
    .materials,
    .two-grid {
      grid-template-columns: 1fr;
    }

    .button {
      width: 100%;
    }
  }
</style>
